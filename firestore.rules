rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'points', 'completedMissions', 'co2SavedTotalG']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'points', 'completedMissions', 'co2SavedTotalG', 'level', 'updatedAt']) &&
        data.uid == userId &&
        data.name is string && data.name.size() <= 64 &&
        data.points is number && data.points >= 0 &&
        data.completedMissions is number && data.completedMissions >= 0 &&
        data.co2SavedTotalG is number && data.co2SavedTotalG >= 0 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Transaction validation
    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'points', 'date', 'category']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'points', 'date', 'category']) &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.title is string && data.title.size() <= 128 &&
        data.points is number &&
        data.date is string && data.date.size() <= 64 &&
        data.category in ['mission', 'coupon', 'bonus'];
    }

    // Coupon validation
    function isValidUserCoupon(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'code', 'used']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'subtitle', 'category', 'requiredPoints', 'discountText', 'code', 'expiresAt', 'description', 'used', 'usedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.title is string && data.title.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.used is bool &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 128)) &&
        (!('category' in data) || (data.category in ['ticket', 'goods', 'food', 'eco'])) &&
        (!('requiredPoints' in data) || (data.requiredPoints is number)) &&
        (!('discountText' in data) || (data.discountText is string && data.discountText.size() <= 64)) &&
        (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 512)) &&
        (!('usedAt' in data) || (data.usedAt is string && data.usedAt.size() <= 64));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid;
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update, delete: if false; // Immutable audit log
      }

      // Coupons subcollection
      match /coupons/{couponId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(couponId) && isValidUserCoupon(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(couponId) && isValidUserCoupon(incoming(), userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedAt']);
        allow delete: if false;
      }
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
